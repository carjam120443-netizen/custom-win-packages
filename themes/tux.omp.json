{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .UserName }}@{{ .HostName }} :: TUX",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "type": "text", "style": "plain", "foreground": "#87D7FF", "template": "🐧 " },
        { "type": "text", "style": "plain", "foreground": "#5FD7AF", "template": "╭─[" },
        { "type": "session", "style": "plain", "foreground": "#FFFFFF", "template": "{{ .UserName }}@{{ .HostName }}" },
        { "type": "text", "style": "plain", "foreground": "#5FD7AF", "template": "]─[" },
        { "type": "path", "style": "plain", "foreground": "#87D7FF", "template": "{{ .Path }}" },
        { "type": "git", "style": "plain", "foreground": "#D7AF5F", "template": " {{ .HEAD }}{{ if .Working.Changed }}*{{ end }}{{ if .Staging.Changed }}+{{ end }}" },
        { "type": "text", "style": "plain", "foreground": "#5FD7AF", "template": "]" }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "type": "text", "style": "plain", "foreground": "#5FD7AF", "template": "╰─[" },
        { "type": "status", "style": "plain", "foreground": "#5FD7AF", "foreground_templates": ["{{ if .Error }}#FF5F5F{{ end }}"], "template": "{{ if .Error }}ERROR{{ else }}READY{{ end }}" },
        { "type": "text", "style": "plain", "foreground": "#5FD7AF", "template": "] $ " }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        { "type": "executiontime", "style": "plain", "foreground": "#808080", "template": " {{ .FormattedMs }} " },
        { "type": "time", "style": "plain", "foreground": "#87D7FF", "template": "{{ .CurrentDate | date .Format }}", "properties": { "time_format": "15:04:05" } }
      ]
    }
  ],
  "transient_prompt": { "foreground": "#5FD7AF", "background": "transparent", "template": "❯ " },
  "secondary_prompt": { "foreground": "#87D7FF", "background": "transparent", "template": "… " }
}
